# Copy to `.env` and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#
# These values are meant to be public — they ship in the client bundle by design.
# Firestore access is controlled by firestore.rules, not by keeping these secret.

# Leave as `json` to read data/buildings.json. Set to `firestore` once seeded.
PUBLIC_DATA_SOURCE=json

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
