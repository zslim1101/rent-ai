# Copy this file and name the copy `.env`, then fill in the blanks.
#
# You find these values in the Firebase website:
#   Project settings -> General -> Your apps -> the web app you added
#
# These are not passwords. They're meant to be visible to anyone who visits your
# site. What protects your information is the firestore.rules file, not these.


# Where the website gets its information from.
#   json      = the data/buildings.json file in this folder (the default)
#   firestore = your online Firebase database
PUBLIC_DATA_SOURCE=json


# Show the made-up buildings as well as the real ones.
#
# The made-up ones live in data/buildings.sample.json. Every number in that file
# is invented — they are there so the site has something to show while there is
# little real data. Set this to true to see them, marked in amber so nobody
# mistakes them for real rents. Leave it out to show only real buildings.
#
# Either way they are never uploaded to Firebase: `npm run seed` sends
# data/buildings.json and nothing else.
PUBLIC_INCLUDE_SAMPLE=false


# Your Firebase details go below.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
